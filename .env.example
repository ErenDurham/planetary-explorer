# ---- Backend ---------------------------------------------------------------
# Comma-separated origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM used by the explanation engine. Leave the key empty to run with the
# deterministic fallback only; the app stays fully usable without it.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Embedding model for the retrieval engine. "local" uses the bundled
# TF-IDF/BM25 hybrid with no downloads; "chroma-default" uses ChromaDB's
# default sentence-transformer (downloads ~80 MB on first run).
EMBEDDING_BACKEND=local
VECTOR_INDEX_DIR=backend/data/index

# Where the versioned preprocessed profiles live (relative to repo root).
DATA_DIR=backend/data
PROFILE_VERSION=v1

# ---- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
