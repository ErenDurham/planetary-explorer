# ---- Backend ---------------------------------------------------------------
# Comma-separated origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Language model that reads the mission objective into research-backed
# priorities. Without one, the priorities fall back to keyword matching and
# rarely change; the rest of the app works either way.
#
#   ollama    - free, runs on this computer (https://ollama.com). Install
#               Ollama, then `ollama pull <OLLAMA_MODEL>`. Used only for the
#               mission objective unless OLLAMA_FEATURES says otherwise
#               (add "astro" to let it answer the Astro assistant too).
#   anthropic - Claude API (paid, needs ANTHROPIC_API_KEY); also writes the
#               Research tab explanations.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Gemma 4 26B-A4B (QAT 4-bit, ~16 GB): mixture-of-experts, ~4B active per
# token, so it runs at a usable speed on a CPU with 32 GB of RAM. On 16 GB
# machines use qwen3.5:9b (~7 GB) instead.
OLLAMA_MODEL=gemma4:26b-a4b-it-qat
# Reasoning before answering: better on hard missions, much slower on CPU.
OLLAMA_THINK=false
# Answers taking longer than this (seconds) fall back to keyword matching.
OLLAMA_TIMEOUT_S=30
# Keep the model in memory between requests (-1 = until Ollama stops; uses
# ~15 GB RAM). "30m" frees memory after 30 idle minutes, but the next mission
# then takes over a minute.
OLLAMA_KEEP_ALIVE=-1
# Load the model and cache the prompt in the background when the server starts.
OLLAMA_WARMUP=true
OLLAMA_FEATURES=interpret

LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Embedding model for the retrieval engine. "local" uses the bundled
# TF-IDF/BM25 hybrid with no downloads; "chroma-default" uses ChromaDB's
# default sentence-transformer (downloads ~80 MB on first run).
EMBEDDING_BACKEND=local
VECTOR_INDEX_DIR=backend/data/index

# Where the versioned preprocessed profiles live (relative to repo root).
DATA_DIR=backend/data
PROFILE_VERSION=v1

# ---- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
